<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.rep3.MainController"
            prefWidth="1200.0"
            prefHeight="720.0"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <VBox spacing="4.0" styleClass="header">
            <padding>
                <Insets top="18.0" right="25.0" bottom="18.0" left="25.0"/>
            </padding>

            <Label text="ORGANIZER"
                   styleClass="title"/>

            <Label text="Управление проектными задачами"
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.72">

            <VBox spacing="15.0" styleClass="main-panel">

                <padding>
                    <Insets top="20.0" right="15.0" bottom="20.0" left="20.0"/>
                </padding>

                <Label text="Задачи"
                       styleClass="section-title"/>

                <HBox spacing="10.0">

                    <TextField fx:id="searchField"
                               promptText="Поиск по исполнителю..."
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="statusFilter"
                              promptText="Статус"
                              prefWidth="145.0"/>

                    <ComboBox fx:id="categoryFilter"
                              promptText="Категория"
                              prefWidth="145.0"/>

                    <Button text="Найти"
                            onAction="#onSearch"
                            styleClass="primary-button"/>

                    <Button text="Сбросить"
                            onAction="#onResetFilters"/>

                </HBox>

                <HBox spacing="10.0">

                    <Label text="Сортировка:"/>

                    <ComboBox fx:id="sortComboBox"
                              promptText="Выберите критерий"
                              prefWidth="210.0"/>

                    <Button text="Сортировать"
                            onAction="#onSort"/>

                </HBox>

                <TableView fx:id="taskTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="ID"
                                     prefWidth="55.0"/>

                        <TableColumn fx:id="titleColumn"
                                     text="Название"
                                     prefWidth="180.0"/>

                        <TableColumn fx:id="executorColumn"
                                     text="Исполнитель"
                                     prefWidth="140.0"/>

                        <TableColumn fx:id="deadlineColumn"
                                     text="Срок"
                                     prefWidth="110.0"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Статус"
                                     prefWidth="130.0"/>

                        <TableColumn fx:id="categoryColumn"
                                     text="Категория"
                                     prefWidth="120.0"/>

                    </columns>

                </TableView>

                <HBox spacing="10.0">

                    <Button text="Удалить"
                            onAction="#onDeleteTask"
                            styleClass="danger-button"/>

                    <Button text="Выполнено"
                            onAction="#onMarkDone"
                            styleClass="success-button"/>

                    <Button text="Обновить список"
                            onAction="#onRefresh"/>

                </HBox>

            </VBox>

            <VBox spacing="14.0" styleClass="form-panel">

                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Label text="Редактор задачи"
                       styleClass="section-title"/>

                <VBox spacing="6.0">
                    <Label text="Название"/>
                    <TextField fx:id="titleField"
                               promptText="Название задачи"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Описание"/>
                    <TextArea fx:id="descriptionArea"
                              promptText="Описание задачи"
                              prefRowCount="4"
                              wrapText="true"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Исполнитель"/>
                    <TextField fx:id="executorField"
                               promptText="Имя исполнителя"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Срок выполнения"/>
                    <DatePicker fx:id="deadlinePicker"
                                maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Статус"/>
                    <ComboBox fx:id="statusComboBox"
                              maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Категория"/>
                    <ComboBox fx:id="categoryComboBox"
                              maxWidth="Infinity"/>
                </VBox>

                <Separator/>

                <Button text="Добавить задачу"
                        onAction="#onAddTask"
                        maxWidth="Infinity"
                        styleClass="primary-button"/>

                <Button text="Сохранить изменения"
                        onAction="#onUpdateTask"
                        maxWidth="Infinity"
                        styleClass="success-button"/>

                <Button text="Очистить форму"
                        onAction="#onClearForm"
                        maxWidth="Infinity"/>

                <Separator/>

                <Label text="Источник данных"
                       styleClass="small-title"/>

                <Label fx:id="dataSourceLabel"
                       text="Collection"
                       styleClass="datasource-label"/>

                <Button fx:id="syncButton"
                        text="Синхронизировать источники"
                        onAction="#onSynchronize"
                        maxWidth="Infinity"/>

            </VBox>

        </SplitPane>
    </center>

    <bottom>
        <HBox styleClass="footer">
            <padding>
                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>

            <Label fx:id="statusLabel"
                   text="Готово"
                   styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>